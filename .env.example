# ═══════════════════════════════════════════════════════════════
# WALLY DEV LAB — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
#
# 1. Copy this file and rename it to .env.local
#      cp .env.example .env.local
#
# 2. Fill in each value below
#
# 3. Restart your dev server
#      npm run dev
#
# NEVER commit .env.local — it is already in .gitignore.
# This .env.example file IS safe to commit (no real secrets).
# ═══════════════════════════════════════════════════════════════


# ── DATABASE (Prisma Postgres) ─────────────────────────────────
# Prisma Console > Your Project > Connection String
DATABASE_URL=

# ── EMAILJS (Contact Form) ────────────────────────────────────
# These are SERVER-ONLY — never prefix with NEXT_PUBLIC_
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=

# ── UPSTASH (Rate Limiting) ───────────────────────────────────
# Upstash Console > Your Database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
