# ═══════════════════════════════════════════════════════════════
# WALLY DEV LAB — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
#
# 1. Copy this file and rename it to .env.local
#      cp .env.example .env.local
#
# 2. Fill in each value below
#
# 3. Restart your dev server
#      npm run dev
#
# NEVER commit .env.local — it is already in .gitignore.
# This .env.example file IS safe to commit (no real secrets).
# ═══════════════════════════════════════════════════════════════


# ── DATABASE (Prisma Postgres) ─────────────────────────────────
# Prisma Console > Your Project > Connection String
DATABASE_URL=

# ── EMAILJS (Contact Form) ────────────────────────────────────
# EmailJS Dashboard > Email Services > Service ID
NEXT_PUBLIC_EMAILJS_SERVICE_ID=

# EmailJS Dashboard > Email Templates > Main Template > Template ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# EmailJS Dashboard > Email Templates > Auto Reply Template > Template ID
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# EmailJS Dashboard > Account > General > Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
